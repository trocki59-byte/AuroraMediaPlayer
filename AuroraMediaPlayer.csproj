<Project Sdk="Microsoft.NET.Sdk">

	<!--
		TROÇKİ® AURORA MEDIA PLAYER
		Android + iPhone/iPad müzik ve video oynatıcı (tek ortak proje)
		.NET 10 MAUI · SQLite · CommunityToolkit MediaElement (Android: ExoPlayer · iOS: AVPlayer)

		Windows'ta proje yalnızca Android olarak açılır. iPhone: Mac'te otomatik eklenir;
		Windows'ta "Pair to Mac" ile çalışacaksanız -p:AuroraTarget=all kullanın.
	-->

	<PropertyGroup>
		<!-- Windows'ta varsayılan: yalnızca Android (iOS iş yükü gerekmez). Mac'te: Android + iOS. -->
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">net10.0-android;net10.0-ios</TargetFrameworks>
		<TargetFrameworks Condition="'$(AuroraTarget)' == 'all'">net10.0-android;net10.0-ios</TargetFrameworks>
		<TargetFrameworks Condition="'$(AuroraTarget)' == 'android'">net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="'$(AuroraTarget)' == 'ios'">net10.0-ios</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>AuroraMediaPlayer</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>

		<!-- Uygulama kimliği (Android paket adı = iOS Bundle ID) -->
		<ApplicationTitle>Aurora Media Player</ApplicationTitle>
		<ApplicationId>com.trocki.auroramediaplayer</ApplicationId>
		<ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>

		<NoWarn>$(NoWarn);XC0022;XC0025;CA1416;CA1422;CS0618</NoWarn>
	</PropertyGroup>

	<!-- ================= ANDROID ================= -->

	<!-- Release: hem APK (doğrudan kurulum) hem AAB (Google Play) üretir -->
	<PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-android' and '$(Configuration)' == 'Release'">
		<AndroidPackageFormats>aab;apk</AndroidPackageFormats>
		<AndroidLinkTool>r8</AndroidLinkTool>
	</PropertyGroup>

	<!-- İmzalama (Google Play için). Değerleri build_aab.bat içinden geçirin, buraya şifre yazmayın. -->
	<PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-android' and '$(Configuration)' == 'Release' and '$(AndroidSigningKeyStore)' != ''">
		<AndroidKeyStore>true</AndroidKeyStore>
	</PropertyGroup>

	<!-- ================= iOS ================= -->

	<!-- Cihaz için Release: .ipa üretir. İmza anahtarı ve profil komut satırından verilir (build_ios.sh / GitHub Actions). -->
	<PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-ios' and '$(Configuration)' == 'Release'">
		<RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
		<ArchiveOnBuild>true</ArchiveOnBuild>
		<MtouchLink>SdkOnly</MtouchLink>
	</PropertyGroup>

	<ItemGroup>
		<!-- Uygulama simgesi (arka plan + ön plan) -->
		<MauiIcon Include="Resources\AppIcon\appicon.png" ForegroundFile="Resources\AppIcon\appiconfg.png" ForegroundScale="0.62" Color="#070B22" />

		<!-- Açılış ekranı -->
		<MauiSplashScreen Include="Resources\Splash\splash.png" Color="#050816" BaseSize="200,200" />

		<!-- Görseller: 4x kaynaklardan ölçeklenir -->
		<MauiImage Include="Resources\Images\logo_full.png" BaseSize="346,124" />
		<MauiImage Include="Resources\Images\logo_mark.png" BaseSize="128,128" />
		<MauiImage Include="Resources\Images\ic_*.png" BaseSize="32,32" />

		<!-- Yazı tipleri -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Ham dosyalar (arka plan resimleri) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<!-- Windows masaüstü programı ve web kaynakları ayrı projelerdir; mobil uygulamaya katılmaz -->
	<ItemGroup>
		<Compile Remove="desktop-net/**" />
		<None Remove="desktop-net/**" />
		<EmbeddedResource Remove="desktop-net/**" />
		<Content Remove="desktop-net/**" />
		<Compile Remove="web-src/**;docs/**;desktop-vb/**" />
		<EmbeddedResource Remove="desktop-vb/**" />
		<None Remove="web-src/**;docs/**;desktop-vb/**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.90" />
		<PackageReference Include="CommunityToolkit.Maui.MediaElement" Version="10.0.0" />
		<PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
		<PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.11" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
	</ItemGroup>

</Project>
