<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

	<!-- Aurora Dark paleti -->
	<Color x:Key="BgDeep">#050816</Color>
	<Color x:Key="BgNight">#081030</Color>
	<Color x:Key="Surface">#B30B1434</Color>
	<Color x:Key="SurfaceSolid">#0B1434</Color>
	<Color x:Key="SurfaceRaised">#CC111C46</Color>
	<Color x:Key="Stroke">#2E6E8CFF</Color>
	<Color x:Key="StrokeSoft">#1FFFFFFF</Color>

	<Color x:Key="AuroraCyan">#2FE3FF</Color>
	<Color x:Key="AuroraBlue">#3B7BFF</Color>
	<Color x:Key="AuroraPurple">#B04BFF</Color>
	<Color x:Key="AuroraPink">#FF4BD8</Color>
	<Color x:Key="AuroraGreen">#3CFFB4</Color>
	<Color x:Key="HeartRed">#FF4B6E</Color>

	<Color x:Key="TextPrimary">#FFFFFF</Color>
	<Color x:Key="TextSecondary">#B7C2E6</Color>
	<Color x:Key="TextDim">#7E8AB3</Color>

	<SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}" />

	<!-- Seçili sekme / ana buton gradyanları -->
	<LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
		<GradientStop Color="#2FE3FF" Offset="0" />
		<GradientStop Color="#3B7BFF" Offset="0.5" />
		<GradientStop Color="#B04BFF" Offset="1" />
	</LinearGradientBrush>

	<LinearGradientBrush x:Key="SelectedTabFill" StartPoint="0,0" EndPoint="0,1">
		<GradientStop Color="#E62466FF" Offset="0" />
		<GradientStop Color="#E6153A9E" Offset="1" />
	</LinearGradientBrush>

	<LinearGradientBrush x:Key="TabFill" StartPoint="0,0" EndPoint="0,1">
		<GradientStop Color="#CC121C48" Offset="0" />
		<GradientStop Color="#CC0A1130" Offset="1" />
	</LinearGradientBrush>

	<LinearGradientBrush x:Key="CardFill" StartPoint="0,0" EndPoint="0,1">
		<GradientStop Color="#E00C1538" Offset="0" />
		<GradientStop Color="#F0070C24" Offset="1" />
	</LinearGradientBrush>

	<LinearGradientBrush x:Key="CardStroke" StartPoint="0,0" EndPoint="1,1">
		<GradientStop Color="#992FE3FF" Offset="0" />
		<GradientStop Color="#663B7BFF" Offset="0.5" />
		<GradientStop Color="#99B04BFF" Offset="1" />
	</LinearGradientBrush>

	<LinearGradientBrush x:Key="PlayButtonFill" StartPoint="0,0" EndPoint="1,1">
		<GradientStop Color="#1B2C7A" Offset="0" />
		<GradientStop Color="#0B1440" Offset="1" />
	</LinearGradientBrush>

	<LinearGradientBrush x:Key="HeaderFade" StartPoint="0,0" EndPoint="0,1">
		<GradientStop Color="#00050816" Offset="0" />
		<GradientStop Color="#33050816" Offset="0.55" />
		<GradientStop Color="#FF050816" Offset="1" />
	</LinearGradientBrush>

	<LinearGradientBrush x:Key="ChromeTopFade" StartPoint="0,0" EndPoint="0,1">
		<GradientStop Color="#CC000000" Offset="0" />
		<GradientStop Color="#00000000" Offset="1" />
	</LinearGradientBrush>

	<LinearGradientBrush x:Key="ChromeBottomFade" StartPoint="0,0" EndPoint="0,1">
		<GradientStop Color="#00000000" Offset="0" />
		<GradientStop Color="#E6000000" Offset="1" />
	</LinearGradientBrush>

	<LinearGradientBrush x:Key="ArtFade" StartPoint="0,0" EndPoint="0,1">
		<GradientStop Color="#33050816" Offset="0" />
		<GradientStop Color="#99050816" Offset="1" />
	</LinearGradientBrush>

</ResourceDictionary>
