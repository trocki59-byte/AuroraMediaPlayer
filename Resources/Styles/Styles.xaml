<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

	<Style TargetType="Label">
		<Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
		<Setter Property="FontFamily" Value="Poppins" />
		<Setter Property="FontSize" Value="14" />
	</Style>

	<Style x:Key="TitleLabel" TargetType="Label">
		<Setter Property="FontFamily" Value="PoppinsBold" />
		<Setter Property="FontSize" Value="19" />
		<Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
	</Style>

	<Style x:Key="CaptionLabel" TargetType="Label">
		<Setter Property="FontFamily" Value="Poppins" />
		<Setter Property="FontSize" Value="12" />
		<Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
	</Style>

	<Style x:Key="TimeLabel" TargetType="Label">
		<Setter Property="FontFamily" Value="PoppinsMedium" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
		<Setter Property="VerticalOptions" Value="Center" />
	</Style>

	<Style x:Key="SectionHeader" TargetType="Label">
		<Setter Property="FontFamily" Value="PoppinsBold" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="TextColor" Value="{StaticResource AuroraCyan}" />
		<Setter Property="Margin" Value="4,18,4,6" />
		<Setter Property="CharacterSpacing" Value="1.5" />
	</Style>

	<!-- Saydam simge butonu (kontrol çubuğu) -->
	<Style x:Key="IconButton" TargetType="ImageButton">
		<Setter Property="BackgroundColor" Value="Transparent" />
		<Setter Property="WidthRequest" Value="46" />
		<Setter Property="HeightRequest" Value="46" />
		<Setter Property="Padding" Value="11" />
		<Setter Property="CornerRadius" Value="23" />
		<Setter Property="Aspect" Value="AspectFit" />
		<Setter Property="VerticalOptions" Value="Center" />
	</Style>

	<!-- Yuvarlak cam buton (başlık, video yan butonları) -->
	<Style x:Key="GlassCircleButton" TargetType="ImageButton">
		<Setter Property="BackgroundColor" Value="#A00A1236" />
		<Setter Property="BorderColor" Value="#665B9BFF" />
		<Setter Property="BorderWidth" Value="1.5" />
		<Setter Property="WidthRequest" Value="52" />
		<Setter Property="HeightRequest" Value="52" />
		<Setter Property="CornerRadius" Value="26" />
		<Setter Property="Padding" Value="13" />
		<Setter Property="Aspect" Value="AspectFit" />
		<Setter Property="Shadow">
			<Shadow Brush="#3B7BFF" Opacity="0.55" Radius="14" Offset="0,0" />
		</Setter>
	</Style>

	<Style TargetType="Slider">
		<Setter Property="MinimumTrackColor" Value="{StaticResource AuroraCyan}" />
		<Setter Property="MaximumTrackColor" Value="#40FFFFFF" />
		<Setter Property="ThumbColor" Value="#8CF2FF" />
	</Style>

	<Style TargetType="Switch">
		<Setter Property="OnColor" Value="{StaticResource AuroraBlue}" />
		<Setter Property="ThumbColor" Value="White" />
	</Style>

	<Style TargetType="SearchBar">
		<Setter Property="TextColor" Value="White" />
		<Setter Property="PlaceholderColor" Value="{StaticResource TextDim}" />
		<Setter Property="CancelButtonColor" Value="{StaticResource AuroraCyan}" />
		<Setter Property="FontFamily" Value="Poppins" />
		<Setter Property="BackgroundColor" Value="#80111C46" />
	</Style>

	<Style TargetType="ActivityIndicator">
		<Setter Property="Color" Value="{StaticResource AuroraCyan}" />
	</Style>

	<Style TargetType="ProgressBar">
		<Setter Property="ProgressColor" Value="{StaticResource AuroraCyan}" />
	</Style>

	<Style x:Key="PillButton" TargetType="Button">
		<Setter Property="FontFamily" Value="PoppinsMedium" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="TextColor" Value="White" />
		<Setter Property="Background" Value="{StaticResource AccentGradient}" />
		<Setter Property="CornerRadius" Value="22" />
		<Setter Property="HeightRequest" Value="44" />
		<Setter Property="Padding" Value="22,0" />
	</Style>

	<Style x:Key="OutlineButton" TargetType="Button">
		<Setter Property="FontFamily" Value="PoppinsMedium" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="TextColor" Value="White" />
		<Setter Property="BackgroundColor" Value="#80111C46" />
		<Setter Property="BorderColor" Value="{StaticResource Stroke}" />
		<Setter Property="BorderWidth" Value="1" />
		<Setter Property="CornerRadius" Value="14" />
		<Setter Property="HeightRequest" Value="44" />
	</Style>

	<!-- Ayarlar satırı -->
	<Style x:Key="SettingCard" TargetType="Border">
		<Setter Property="Background" Value="#990E1840" />
		<Setter Property="Stroke" Value="{StaticResource StrokeSoft}" />
		<Setter Property="StrokeThickness" Value="1" />
		<Setter Property="Padding" Value="14,10" />
		<Setter Property="StrokeShape" Value="RoundRectangle 14" />
	</Style>

	<Style TargetType="Page" ApplyToDerivedTypes="True">
		<Setter Property="BackgroundColor" Value="{StaticResource BgDeep}" />
	</Style>

</ResourceDictionary>
