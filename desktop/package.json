{
  "name": "aurora-media-player",
  "productName": "Aurora Media Player",
  "version": "2.0.0",
  "description": "TROÇKİ® Aurora Media Player — Sen İzle, Dünya Güzelleşsin…",
  "author": "TROÇKİ Software",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.trocki.auroramediaplayer",
    "productName": "Aurora Media Player",
    "copyright": "© TROÇKİ Software",
    "directories": { "output": "dist" },
    "files": ["main.js", "offline/**", "build/icon.ico"],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Aurora Media Player",
      "artifactName": "AuroraMediaPlayer-Kurulum-${version}.${ext}"
    },
    "portable": {
      "artifactName": "AuroraMediaPlayer-Tasinabilir-${version}.${ext}"
    }
  }
}
